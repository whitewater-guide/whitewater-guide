{
  "[java]": {
    "editor.formatOnSave": false
  },
  "[sql]": {
    "editor.formatOnSave": false
  },
  "editor.codeActionsOnSave": [
    "source.fixAll.eslint"
  ],
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "search.exclude": {
    "**/__generated__": true,
    "**/.idea/**": true,
    "**/*.generated.*": true,
    "**/build": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/Pods/**": true,
    "**/*.log": true,
    "**/yarn.lock": true,
    "**/pnpm-lock.yaml": true,
    "**/.cxx": true
  },
  "search.useIgnoreFiles": false,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.hg/store/**": true,
    "**/.idea/**": true,
    "**/*.log": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/node_modules/*/**": true,
    "**/Pods/**": true,
    "**/yarn.lock": true,
    "**/pnpm-lock.yaml": true
  }
}