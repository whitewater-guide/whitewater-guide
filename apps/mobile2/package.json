    "storybook:start": "export STORYBOOK_ENABLED=true && react-native start --reset-cache",
    "storybook:ios": "export STORYBOOK_ENABLED=true && react-native run-ios",
    "storybook:android": "export STORYBOOK_ENABLED=true && react-native run-android",
